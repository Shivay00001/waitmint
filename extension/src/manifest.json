{
  "manifest_version": 3,
  "name": "WaitMint — Earn while AI thinks",
  "version": "1.0.0",
  "description": "Shows a small, clearly labelled sponsored card while your AI chat is thinking — and shares the ad revenue with you. Full privacy: never reads your prompts or answers.",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
