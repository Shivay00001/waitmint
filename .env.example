# WaitMint Ad Platform — environment configuration
# Copy to .env (or set in the Render dashboard). NEVER commit a real .env.

# Secret token for the /admin/* endpoints. Requests must send it in the
# x-admin-token header. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, ALL admin endpoints are disabled (503) — fail closed.
ADMIN_TOKEN=

# Port the server listens on. Render sets this automatically.
PORT=3000

# Directory for the JSON data store + notifications.log.
# On Render free tier the filesystem is ephemeral: data resets on redeploy.
# Acceptable for the founding phase; move to a disk/DB before scaling.
DATA_DIR=./data

# How long (seconds) clients/edges may cache /ads.json.
FEED_CACHE_SECONDS=300

# Per-IP per-minute rate limits (defaults shown). Raise TRACK_RATE_PER_MIN
# if many users share NAT addresses; the test suite sets these very high.
# SUBMIT_RATE_PER_MIN=5
# TRACK_RATE_PER_MIN=1200
# ADMIN_RATE_PER_MIN=120
